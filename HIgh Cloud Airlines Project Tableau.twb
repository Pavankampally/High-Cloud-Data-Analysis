      <column caption='Date ' datatype='date' datatype-customized='true' name='[Calculation_1063975415371304960]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;dd/MM/yyyy&quot;, STR([Day])+ &quot;/&quot; +STR([Month (#)]) + &quot;/&quot; +STR([Year]) )) ' />
      </column>
      <column caption='Month Name' datatype='string' name='[Calculation_1063975415374180353]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE ([Month (#)])&#13;&#10;&#13;&#10;WHEN 1 THEN &apos;January&apos;&#13;&#10;&#13;&#10;WHEN 2 THEN &apos;February&apos;&#13;&#10;&#13;&#10;WHEN 3 THEN &apos;March&apos;&#13;&#10;&#13;&#10;WHEN 4 THEN &apos;April&apos;&#13;&#10;&#13;&#10;WHEN 5 THEN &apos;May&apos;&#13;&#10;&#13;&#10;WHEN 6 THEN &apos;June&apos;&#13;&#10;&#13;&#10;WHEN 7 THEN &apos;July&apos;&#13;&#10;&#13;&#10;WHEN 8 THEN &apos;August&apos;&#13;&#10;&#13;&#10;WHEN 9 THEN &apos;September&apos;&#13;&#10;&#13;&#10;WHEN 10 THEN &apos;October&apos;&#13;&#10;&#13;&#10;WHEN 11 THEN &apos;November&apos;&#13;&#10;&#13;&#10;WHEN 12 THEN &apos;December&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_1063975415374323714]' role='dimension' type='nominal'>
