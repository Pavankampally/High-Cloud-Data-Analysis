      <column caption='Weekday &amp; Weekends' datatype='string' name='[Calculation_1063975415380058118]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[Calculation_1063975415371304960]) &gt;= 2 AND &#13;&#10;DATEPART(&apos;weekday&apos;,[Calculation_1063975415371304960]) &lt;=6 THEN &apos;Weekday&apos;&#13;&#10;ELSE &apos;Weekend&apos;&#13;&#10;END' />
